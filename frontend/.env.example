# ---------------------------------------------------------------------------
# StellarYield frontend configuration
#
# Copy to `.env` and fill in the values printed by scripts/deploy-testnet.sh
# and scripts/create-vault.sh. See DEPLOYMENT.md for the full walkthrough.
# ---------------------------------------------------------------------------

# Network: "testnet" | "futurenet" | "public" | "local"
VITE_STELLAR_NETWORK=testnet

# Soroban RPC endpoint. Defaults per-network if left unset.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# VaultFactory contract ID — printed as FACTORY_ADDRESS by deploy-testnet.sh.
# The app lists every vault registered in this factory.
VITE_FACTORY_ADDRESS=

# Optional: comma-separated vault contract IDs to show in addition to the
# factory registry. Useful when demoing a vault deployed outside the factory.
VITE_EXTRA_VAULTS=
